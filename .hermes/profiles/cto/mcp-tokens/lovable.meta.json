{
  "issuer": "https://lovable.dev/oauth",
  "authorization_endpoint": "https://lovable.dev/oauth/authorize",
  "token_endpoint": "https://lovable.dev/oauth/token",
  "registration_endpoint": "https://lovable.dev/oauth/register",
  "scopes_supported": [
    "offline",
    "openid",
    "email",
    "profile",
    "projects:create",
    "projects:read",
    "projects:write",
    "workspaces:create",
    "workspaces:read",
    "workspaces:write"
  ],
  "response_types_supported": [
    "code"
