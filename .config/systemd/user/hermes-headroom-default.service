[Unit]
Description=Headroom optimization proxy (default/Claudinho) - port 8788
After=network.target

[Service]
Environment=HEADROOM_WORKSPACE_DIR=/home/hermes/.headroom-default
ExecStart=/home/hermes/headroom-test/venv/bin/headroom proxy --port 8788 --openai-api-url https://api.vultrinference.com/v1 --no-telemetry --lossless
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
