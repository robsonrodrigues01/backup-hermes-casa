[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/hermes/.local/share/uv/tools/hermes-agent/bin/python -m hermes_cli.main --profile cmo gateway run --replace
WorkingDirectory=/home/hermes/.hermes/profiles/cmo
Environment="PATH=/home/hermes/.local/share/uv/tools/hermes-agent/bin:/usr/bin:/home/hermes/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/hermes/.local/share/uv/tools/hermes-agent"
Environment="HERMES_HOME=/home/hermes/.hermes/profiles/cmo"
Restart=always
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
